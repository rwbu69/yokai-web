---
/**
 * src/pages/shop/cheki.astro
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopHero from '../../components/shop/ShopHero.astro';
import TypographicShopList from '../../components/premium/TypographicShopList.astro';
import ShopModal from '../../components/shop/ShopModal.astro';
import ShopClosed from '../../components/shop/ShopClosed.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { sanityClient, urlFor } from '../../lib/sanity';


const query = `{
  "config": *[_type == "chekiConfig"][0] {
    isOpen, closedMessage, heroBgImage, tallyFormUrl
  },
  "items": *[_type == "shopItem" && category == "cheki"] | order(_createdAt asc) {
    "id": slug.current,
    title,
    price,
    available,
    image { asset }
  }
}`;

const data = await sanityClient.fetch(query) || {};
const chekiConfig = data.config || { isOpen: false, closedMessage: 'OUR CHEKI IS CLOSED AT THE MOMENT.', tallyFormUrl: '' };
const tallyFormUrl = chekiConfig.tallyFormUrl || "https://tally.so/r/mZgA9x";

const formattedItems = (data.items || []).map((item: import('@lib/sanity').SanityChekiItem) => ({
  id: item._id,
  name: item.title,
  price: item.price,
  available: item.available,
  imageUrl: item.image?.asset ? urlFor(item.image).width(1920).format('webp').url() : ''
}));
---

<BaseLayout title="Polaroid Cheki | Yokai" activePage="shop">
  <main class="w-full min-h-screen bg-yokai-dark-bg flex flex-col pt-24 pb-8 relative">

    <div class="max-w-7xl mx-auto px-6 md:px-12 w-full pt-4 pb-8 relative z-10">
      <Breadcrumbs paths={[{ name: 'Shop' }, { name: 'Cheki' }]} theme="dark" />
    </div>

    <ShopHero title="POLAROID CHEKI" />

    <div id="cheki-open-view" class="w-full flex-grow flex flex-col items-center justify-center" style={`display: ${chekiConfig.isOpen ? 'flex' : 'none'};`}>
      <TypographicShopList items={formattedItems} title="Polaroid Cheki Collection" />
      <ShopModal type="cheki" tallyUrl={tallyFormUrl} />
    </div>

    <div id="cheki-closed-view" class="w-full px-6 flex-grow flex items-start justify-center" style={`display: ${chekiConfig.isOpen ? 'none' : 'flex'};`}>
      <ShopClosed message={chekiConfig.closedMessage} type="cheki" />
    </div>
  </main>
</BaseLayout>


