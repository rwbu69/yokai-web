---
/**
 * src/pages/shop/merch.astro
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopHero from '../../components/shop/ShopHero.astro';
import TypographicShopList from '../../components/premium/TypographicShopList.astro';
import ShopModal from '../../components/shop/ShopModal.astro';
import ShopClosed from '../../components/shop/ShopClosed.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { sanityClient, urlFor } from '../../lib/sanity';

const query = `{
  "config": *[_type == "merchConfig"][0] { isOpen, closedMessage, heroBgImage, tallyFormUrl },
  "items": *[_type == "shopItem" && category == "merch"] | order(_createdAt asc) {
    "id": slug.current,
    title,
    price,
    available,
    description,
    variants,
    image { asset },
    images[] { asset }
  }
}`;
const data = await sanityClient.fetch(query) || {};
const merchItems = data.items || [];
const merchConfig = data.config || { isOpen: false, closedMessage: 'OUR MERCH IS CLOSED AT THE MOMENT.', tallyFormUrl: '' };
const tallyFormUrl = merchConfig.tallyFormUrl || "https://tally.so/r/mZgA9x";

const formattedItems = merchItems.map((item: import('@lib/sanity').SanityMerchItem) => ({
  id: item._id,
  name: item.title,
  price: item.price,
  available: item.available,
  description: item.description,
  variants: item.variants,
  imageUrl: item.image?.asset ? urlFor(item.image).width(800).format('webp').url() : '',
  gallery: item.images ? item.images.map((img: import('@lib/sanity').SanityImage) => img.asset ? urlFor(img).width(800).format('webp').url() : '').filter(Boolean) : []
}));

---

<BaseLayout title="Official Merch | Yokai" activePage="shop">
  <main class="w-full min-h-screen bg-yokai-dark-bg flex flex-col pt-24 pb-8 relative">

    <div class="max-w-7xl mx-auto px-6 md:px-12 w-full pt-4 pb-8 relative z-10">
      <Breadcrumbs paths={[{ name: 'Shop' }, { name: 'Merch' }]} theme="dark" />
    </div>

    <ShopHero 
      title="OFFICIAL MERCH"
      subtitle="Wear the spirit of Yokai. High-quality gear for wotagei practitioners."
    />
    
    <div id="merch-open-view" class="w-full flex-grow flex flex-col items-center justify-center" style={`display: ${merchConfig.isOpen ? 'flex' : 'none'};`}>
      <TypographicShopList items={formattedItems} title="Official Merch Collection" />
      <ShopModal type="merch" tallyUrl={tallyFormUrl} />
    </div>

    <div id="merch-closed-view" class="w-full px-6 flex-grow flex items-start justify-center" style={`display: ${merchConfig.isOpen ? 'none' : 'flex'};`}>
      <ShopClosed message={merchConfig.closedMessage} type="merch" />
    </div>
  </main>
</BaseLayout>


