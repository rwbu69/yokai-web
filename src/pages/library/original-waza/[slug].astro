---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleHeader from '@components/premium/ArticleHeader.astro';
import ArticleBody from '@components/premium/ArticleBody.astro';

import { sanityClient, urlFor } from '../../../lib/sanity';
import { PortableText } from 'astro-portabletext';
import { parseMarkdown } from '../../../lib/markdown';

export async function getStaticPaths() {
  const query = `*[_type == "waza" && wazaType == "originalMember"] {
    "slug": slug.current,
    title,
    titleJp,
    date,
    coverImage,
    tags,
    honke,
    body
  }`;
  const posts = await sanityClient.fetch(query) || [];
  return posts.map((post: any) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

if (!post) {
  return Astro.redirect('/404');
}

const coverImageUrl = post.coverImage ? urlFor(post.coverImage).width(1200).format('webp').url() : '';

const breadcrumbs = [
  { name: 'Library', href: '/library/original-waza' }, 
  { name: 'Original Waza', href: '/library/original-waza' },
  { name: post.title }
];
---

<BaseLayout title={`${post.title} | Original Waza`} activePage="library" ogImage={coverImageUrl}>
  <main class="min-h-screen bg-yokai-dark-bg flex flex-col">
    
    <ArticleHeader 
      title={post.title} 
      date={post.date ? new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : undefined} 
      author={post.honke}
      category="Original Waza"
      imageUrl={coverImageUrl}
      breadcrumbs={breadcrumbs}
    />
    
    <ArticleBody>
      {post.titleJp && <h2 class="text-xl text-yokai-purple/80 uppercase tracking-widest font-inter mb-8 border-b border-yokai-white/10 pb-4 text-center">{post.titleJp}</h2>}
      {typeof post.body === 'string' ? (
        <div set:html={parseMarkdown(post.body)} />
      ) : (
        <PortableText value={post.body ?? []} />
      )}
    </ArticleBody>
    
  </main>
</BaseLayout>
