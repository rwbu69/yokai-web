---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArchiveGrid from '@components/premium/ArchiveGrid.astro';
import Breadcrumbs from '@components/common/Breadcrumbs.astro';

import { sanityClient, urlFor } from '../../../lib/sanity';

const query = `*[_type == "waza" && wazaType == "originalMember"] | order(date desc) {
  "id": slug.current,
  title,
  titleJp,
  description,
  date,
  coverImage
}`;

const posts = await sanityClient.fetch(query) || [];
interface ProjectedLibraryItem {
  id: string;
  title: string;
  titleJp?: string;
  description: string;
  coverImage?: import('@lib/sanity').SanityImage;
  date: string;
}

const formattedPosts = posts.map((post: ProjectedLibraryItem) => ({
  id: post.id,
  title: post.title,
  titleJp: post.titleJp,
  href: `/library/original-waza/${post.id}`,
  imageUrl: post.coverImage ? urlFor(post.coverImage).width(800).format('webp').url() : undefined
}));
---

<BaseLayout title={`Original Waza | Yokai Library`} activePage="library">
  <main class="min-h-screen bg-yokai-dark-bg flex flex-col pt-24">
    
    <div class="max-w-7xl mx-auto px-6 md:px-12 w-full mb-12">
      <Breadcrumbs paths={[{ name: 'Library' }, { name: 'Original Waza' }]} theme="dark" />
      <h1 class="font-jakarta font-black text-4xl md:text-6xl uppercase tracking-tighter text-yokai-white mt-8">
        Original Waza
      </h1>
      <p class="font-inter text-yokai-white/50 tracking-widest uppercase mt-4 text-sm max-w-lg">
        Signature moves created by Yokai's own members.
      </p>
    </div>
    
    <!-- Archive Grid -->
    <ArchiveGrid items={formattedPosts} searchPlaceholder="SEARCH ORIGINAL WAZA..." />
  </main>
</BaseLayout>
