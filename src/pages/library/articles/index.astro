---
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialGrid from '@components/premium/EditorialGrid.astro';
import Breadcrumbs from '@components/common/Breadcrumbs.astro';

import { sanityClient, urlFor } from '../../../lib/sanity';

const query = `*[_type == "article" && draft != true] | order(date desc) {
  "id": slug.current,
  title,
  description,
  date,
  author,
  coverImage
}`;

const posts = await sanityClient.fetch(query) || [];
interface ProjectedLibraryItem {
  id: string;
  title: string;
  description: string;
  author?: string;
  coverImage?: import('@lib/sanity').SanityImage;
  date: string;
}

const editorialLibrary = posts.map((item: ProjectedLibraryItem) => ({
  id: item.id,
  title: item.title,
  description: item.description,
  date: item.date,
  author: item.author,
  href: '/library/articles/' + item.id,
  imageUrl: item.coverImage ? urlFor(item.coverImage).width(800).format('webp').url() : ''
}));
---

<BaseLayout title={`Articles | Yokai Library`} activePage="library">
  <main class="min-h-screen bg-yokai-dark-bg flex flex-col pt-24">
    
    <div class="max-w-7xl mx-auto px-6 md:px-12 w-full mb-12">
      <Breadcrumbs paths={[{ name: 'Library' }, { name: 'Articles' }]} theme="dark" />
      <h1 class="font-jakarta font-black text-4xl md:text-6xl uppercase tracking-tighter text-yokai-white mt-8">
        Articles
      </h1>
      <p class="font-inter text-yokai-white/50 tracking-widest uppercase mt-4 text-sm max-w-lg">
        In-depth essays, guides, and thoughts on the wotagei culture.
      </p>
    </div>
    
    <!-- Editorial Grid -->
    <EditorialGrid items={editorialLibrary} />
  </main>
</BaseLayout>
