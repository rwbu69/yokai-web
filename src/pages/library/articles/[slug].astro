---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostHeader from '@components/blog/PostHeader.astro';
import PostLayout from '@components/blog/PostLayout.astro';
import Breadcrumbs from '@components/common/Breadcrumbs.astro';

import { sanityClient, urlFor } from '../../../lib/sanity';
import { PortableText } from 'astro-portabletext';
import { marked } from 'marked';

export async function getStaticPaths() {
  const query = `*[_type == "article" && draft != true] {
    "slug": slug.current
  }`;
  const posts = await sanityClient.fetch(query) || [];
  return posts.map((post: any) => ({
    params: { slug: post.slug }
  }));
}

const { slug } = Astro.params;

const query = `*[_type == "article" && slug.current == $slug][0] {
  title,
  date,
  coverImage,
  tags,
  body
}`;

const post = await sanityClient.fetch(query, { slug });

if (!post) {
  return Astro.redirect('/404');
}

const coverImageUrl = post.coverImage ? urlFor(post.coverImage).width(1200).url() : '';
---

<BaseLayout title={`${post.title} | Articles`} activePage="library" ogImage={coverImageUrl}>
  <main class="min-h-screen bg-yokai-light-bg">
    <PostHeader
      title={post.title}
      coverImage={coverImageUrl}
      date={post.date}
      tags={post.tags}
    />
    <PostLayout backUrl="/library/articles" backText={`Kembali ke Articles`}>
      <Breadcrumbs paths={[{ name: 'Library' }, { name: 'Articles', href: '/library/articles' }, { name: post.title }]} />
      {typeof post.body === 'string' ? (
        <div set:html={marked.parse(post.body)} />
      ) : (
        <PortableText value={post.body ?? []} />
      )}
    </PostLayout>
  </main>
</BaseLayout>
