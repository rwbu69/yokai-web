---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArticleHeader from '@components/premium/ArticleHeader.astro';
import ArticleBody from '@components/premium/ArticleBody.astro';

import { sanityClient, urlFor } from '../../../lib/sanity';
import { PortableText } from 'astro-portabletext';
import { parseMarkdown } from '../../../lib/markdown';

export async function getStaticPaths() {
  const query = `*[_type == "article" && draft != true] {
    "slug": slug.current,
    title,
    date,
    author,
    coverImage,
    tags,
    body
  }`;
  const posts = await sanityClient.fetch(query) || [];
  return posts.map((post: any) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

if (!post) {
  return Astro.redirect('/404');
}

const coverImageUrl = post.coverImage ? urlFor(post.coverImage).width(1200).format('webp').url() : '';

const breadcrumbs = [
  { name: 'Library', href: '/library/articles' }, // Usually we don't have a library root, they go directly to the section
  { name: 'Articles', href: '/library/articles' },
  { name: post.title }
];
---

<BaseLayout title={`${post.title} | Articles`} activePage="library" ogImage={coverImageUrl}>
  <main class="min-h-screen bg-yokai-dark-bg flex flex-col">
    
    <ArticleHeader 
      title={post.title} 
      date={new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} 
      author={post.author}
      category="Article"
      imageUrl={coverImageUrl}
      breadcrumbs={breadcrumbs}
    />
    
    <ArticleBody>
      {typeof post.body === 'string' ? (
        <div set:html={parseMarkdown(post.body)} />
      ) : (
        <PortableText value={post.body ?? []} />
      )}
    </ArticleBody>
    
  </main>
</BaseLayout>
