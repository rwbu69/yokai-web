---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostHero from '@components/blog/PostHero.astro';
import PostGrid from '@components/blog/PostGrid.astro';
import Breadcrumbs from '@components/common/Breadcrumbs.astro';

import { sanityClient, urlFor } from '../../../lib/sanity';

const query = `*[_type == "waza" && wazaType == "wotagei"] | order(dateDesc) {
  "id": slug.current,
  title,
  titleJp,
  description,
  date,
  coverImage
}`;

const posts = await sanityClient.fetch(query) || [];
interface ProjectedLibraryItem {
  id: string;
  title: string;
  titleJp?: string;
  description: string;
  coverImage?: import('@lib/sanity').SanityImage;
  date: string;
}

const formattedPosts = posts.map((post: ProjectedLibraryItem) => ({
  id: post.id,
  data: {
    title: post.title,
    titleJp: post.titleJp,
    description: post.description,
    date: post.date,
    coverImage: post.coverImage ? urlFor(post.coverImage).width(800).url() : '',
  }
}));

formattedPosts.sort(
  (a: { data: { date: string } }, b: { data: { date: string } }) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf()
);
---

<BaseLayout title={`Wotagei Waza | Yokai Library`} activePage="library">
  <main class="min-h-screen bg-yokai-light-bg">
    <!-- Dark Header Section -->
    <div class="bg-yokai-dark-blue rounded-b-[3rem] shadow-[0_10px_40px_rgba(42,30,82,0.1)] relative z-10">
      <PostHero title={"Wotagei Waza"} description={"Daftar waza wotagei umum."} />
    </div>
    
    <!-- Light Grid Section -->
    <div class="pt-8 pb-20 relative z-0">
      <Breadcrumbs paths={[{ name: 'Library' }, { name: 'Wotagei Waza' }]} />
      <div class="mt-8">
        <PostGrid posts={formattedPosts} collection="wotagei-waza" showSearch={true} />
      </div>
    </div>
  </main>
</BaseLayout>
