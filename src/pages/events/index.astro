---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/common/Breadcrumbs.astro';
import { sanityClient, urlFor } from '../../lib/sanity';
import type { SanityImage } from '../../lib/sanity';

interface EventItem {
  name: string;
  slug: { current: string };
  date: string;
  coverImage?: SanityImage;
}

const query = `*[_type == "event"] | order(date desc) {
  name,
  slug,
  date,
  coverImage
}`;

let events = await sanityClient.fetch<EventItem[]>(query) ?? [];

// Placeholder data fallback
if (events.length === 0) {
  events = [
    {
      name: 'Yokai Fest 2026',
      slug: { current: 'yokai-fest-2026' },
      date: '2026-11-15T00:00:00.000Z'
    },
    {
      name: 'Neon Battle Vol. 3',
      slug: { current: 'neon-battle-vol-3' },
      date: '2026-08-20T00:00:00.000Z'
    },
    {
      name: 'Underground Cyalume',
      slug: { current: 'underground-cyalume' },
      date: '2025-12-10T00:00:00.000Z'
    }
  ];
}
---

<BaseLayout title="Events | Yokai Web Studio" activePage="events">
  
  <!-- Breadcrumbs Container (Fixed on top) -->
  <div class="fixed inset-x-0 top-0 z-50 pointer-events-none px-6 md:px-12 pt-24">
    <div class="pointer-events-auto w-fit">
      <Breadcrumbs paths={[{ name: 'Events' }]} />
    </div>
  </div>

  <!-- Main Scroll Container -->
  <div class="absolute inset-0 w-full h-[100dvh] overflow-y-auto snap-y snap-mandatory hide-scrollbar bg-yokai-dark-bg">
    
    {events.map((event, index) => (
      <section class="relative h-[100dvh] w-full snap-start snap-always flex items-center justify-center overflow-hidden">
        
        <!-- Background Image -->
        <div class="absolute inset-0 z-0">
          {event.coverImage?.asset ? (
            <img src={urlFor(event.coverImage).width(1920).height(1080).url()} alt={event.name} class="w-full h-full object-cover" />
          ) : (
            <img src={`https://picsum.photos/seed/${event.slug.current}/1920/1080`} alt={event.name} class="w-full h-full object-cover" />
          )}
          <!-- Gradient overlay for text readability -->
          <div class="absolute inset-0 bg-yokai-dark-bg/60 bg-gradient-to-t from-yokai-dark-bg/90 via-yokai-dark-bg/30 to-yokai-dark-bg/80"></div>
        </div>

        <!-- Typography Content -->
        <a href={`/events/${event.slug.current}`} class="relative z-10 w-full max-w-[90%] md:max-w-7xl mx-auto px-6 flex flex-col items-center text-center group cursor-pointer">
          <p class="text-[10px] md:text-xs font-inter text-yokai-purple font-bold tracking-[0.4em] uppercase mb-6 drop-shadow-md transition-transform duration-700 ease-out group-hover:-translate-y-2">
            {new Date(event.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </p>
          
          <!-- Fluid typography -->
          <h2 class="text-[clamp(3.5rem,8vw,12rem)] font-black font-jakarta uppercase tracking-tighter leading-[0.85] text-yokai-white drop-shadow-2xl transition-transform duration-700 ease-out group-hover:scale-105">
            {event.name}
          </h2>
          
          <!-- Hover CTA -->
          <div class="mt-12 opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out flex items-center justify-center gap-4 group-hover:translate-y-2">
             <span class="font-inter text-[10px] tracking-[0.3em] font-bold uppercase text-yokai-white">Enter Event</span>
             <svg class="w-4 h-4 text-yokai-white transform transition-transform group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
        </a>

        <!-- Scroll Indicator (only visible if not the last item) -->
        {index < events.length - 1 && (
          <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center gap-2 animate-bounce pointer-events-none opacity-40">
            <span class="text-[8px] font-inter uppercase tracking-[0.4em] font-bold text-yokai-white">Scroll Down</span>
            <svg class="w-4 h-4 text-yokai-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
          </div>
        )}

      </section>
    ))}

    {events.length === 0 && (
      <div class="h-[100dvh] w-full flex items-center justify-center bg-yokai-dark-bg">
        <p class="text-yokai-white/30 font-inter uppercase tracking-widest text-sm">No events archived yet.</p>
      </div>
    )}

  </div>
</BaseLayout>

<style>
  /* Hide global body overflow to prevent double scrollbars */
  :global(body) {
    overflow: hidden;
  }
  
  /* Hide scrollbar for cleaner look on the container */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
