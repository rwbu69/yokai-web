---
/**
 * src/pages/updates/[slug].astro
 *
 * AUDIT NOTES (Mei 2026):
 * - Fix: Hapus tipe `any` — ganti dengan typed interface
 * - Fix: image projection dilengkapi dengan { asset }
 * - category tidak di-fetch — sudah dihapus dari schema
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import CinematicHero from '@components/premium/CinematicHero.astro';
import EditorialProse from '@components/premium/EditorialProse.astro';
import RelatedPosts from '@components/blog/RelatedPosts.astro';
import Breadcrumbs from '@components/common/Breadcrumbs.astro';

import { sanityClient, urlFor } from '../../lib/sanity';
import type { SanityImage } from '../../lib/sanity';
import { PortableText } from 'astro-portabletext';
import { parseMarkdown } from '../../lib/markdown';

// ── TypeScript Interfaces ─────────────────────────────────────────────────────

interface SanityUpdateSlug {
  slug: string;
}

interface SanityUpdateDetail {
  title: string;
  date: string;
  image?: SanityImage;
  tags?: string[];
  excerpt?: string;
  content?: import('@lib/sanity').SanityBlock[];
}

// ── getStaticPaths — generate semua slug dari Sanity ─────────────────────────

export async function getStaticPaths() {
  const allPosts = await sanityClient.fetch<any[]>(`
    *[_type == "update"] | order(date desc) {
      "slug": slug.current,
      "id": slug.current,
      title,
      date,
      image {
        asset,
        hotspot
      },
      tags,
      excerpt,
      "description": excerpt,
      content
    }
  `) ?? [];

  return allPosts
    .filter((p) => !!p.slug)
    .map((post) => {
      const relatedPostsRaw = allPosts
        .filter((p) => p.slug !== post.slug)
        .slice(0, 3);
        
      return { 
        params: { slug: post.slug },
        props: { post, relatedPostsRaw }
      };
    });
}

interface Props {
  post: any;
  relatedPostsRaw: any[];
}

const { post, relatedPostsRaw } = Astro.props;

if (!post) {
  return Astro.redirect('/404');
}

const coverImageUrl = post.image?.asset
  ? urlFor(post.image).width(1200).format('webp').url()
  : '';

const relatedPosts = relatedPostsRaw.map((p) => ({
  id: p._id,
  data: {
    title:       p.title,
    description: p.excerpt ?? '',
    date:        p.date,
    coverImage:  p.image?.asset
      ? urlFor(p.image).width(800).format('webp').url()
      : '',
  },
}));
---

<BaseLayout 
  title={`${post.title} | Updates`} 
  activePage="updates" 
  description={post.excerpt}
  ogImage={coverImageUrl}
>
  <main class="min-h-screen bg-yokai-dark-bg">
    <CinematicHero 
      title={post.title} 
      date={new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} 
      imageUrl={coverImageUrl} 
    />
    
    <div class="relative z-20 -mt-24 px-6 md:px-24 w-full flex justify-between items-center mix-blend-difference text-yokai-white">
      <Breadcrumbs paths={[{ name: 'Updates', href: '/updates' }, { name: post.title }]} />
      <a href="/updates" class="text-[10px] font-inter uppercase tracking-[0.2em] font-bold border-b border-yokai-white/30 hover:border-yokai-white transition-colors">
        Kembali
      </a>
    </div>

    <EditorialProse title="News & Updates">
      {typeof post.content === 'string' ? (
        <div set:html={parseMarkdown(post.content)} />
      ) : (
        <PortableText value={post.content ?? []} />
      )}
    </EditorialProse>
    
    {relatedPosts.length > 0 && (
      <section class="bg-yokai-white py-16 border-t border-yokai-dark-bg/10">
        <RelatedPosts posts={relatedPosts} collection="updates" />
      </section>
    )}
  </main>
</BaseLayout>
