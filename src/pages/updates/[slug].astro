---
/**
 * src/pages/updates/[slug].astro
 *
 * AUDIT NOTES (Mei 2026):
 * - Fix: Hapus tipe `any` — ganti dengan typed interface
 * - Fix: image projection dilengkapi dengan { asset }
 * - category tidak di-fetch — sudah dihapus dari schema
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PostHeader from '@components/blog/PostHeader.astro';
import PostLayout from '@components/blog/PostLayout.astro';
import RelatedPosts from '@components/blog/RelatedPosts.astro';
import Breadcrumbs from '@components/common/Breadcrumbs.astro';

import { sanityClient, urlFor } from '../../lib/sanity';
import type { SanityImage } from '../../lib/sanity';
import { PortableText } from 'astro-portabletext';
import { parseMarkdown } from '../../lib/markdown';

// ── TypeScript Interfaces ─────────────────────────────────────────────────────

interface SanityUpdateSlug {
  slug: string;
}

interface SanityUpdateDetail {
  title: string;
  date: string;
  image?: SanityImage;
  tags?: string[];
  excerpt?: string;
  content?: import('@lib/sanity').SanityBlock[];
}

// ── getStaticPaths — generate semua slug dari Sanity ─────────────────────────

export async function getStaticPaths() {
  const slugs = await sanityClient.fetch<SanityUpdateSlug[]>(`
    *[_type == "update"] {
      "slug": slug.current
    }
  `) ?? [];

  return slugs
    .filter((p) => !!p.slug) // skip entri tanpa slug
    .map((p) => ({ params: { slug: p.slug } }));
}

// ── Fetch Detail Post ─────────────────────────────────────────────────────────

const { slug } = Astro.params;

const post = await sanityClient.fetch<SanityUpdateDetail | null>(`
  *[_type == "update" && slug.current == $slug][0] {
    title,
    date,
    image {
      asset,
      hotspot
    },
    tags,
    excerpt,
    content
  }
`, { slug });

if (!post) {
  return Astro.redirect('/404');
}

const coverImageUrl = post.image?.asset
  ? urlFor(post.image).width(1200).format('webp').url()
  : '';

// ── Fetch Related Posts ───────────────────────────────────────────────────────

const relatedPostsRaw = await sanityClient.fetch<import('@lib/sanity').SanityUpdate[]>(`
  *[_type == "update" && slug.current != $slug] | order(date desc)[0...3] {
    "id": slug.current,
    title,
    "description": excerpt,
    date,
    image {
      asset,
      hotspot
    }
  }
`, { slug }) ?? [];

const relatedPosts = relatedPostsRaw.map((p) => ({
  id: p._id,
  data: {
    title:       p.title,
    description: p.excerpt ?? '',
    date:        p.date,
    coverImage:  p.image?.asset
      ? urlFor(p.image).width(800).format('webp').url()
      : '',
  },
}));
---

<BaseLayout 
  title={`${post.title} | Updates`} 
  activePage="updates" 
  description={post.excerpt}
  ogImage={coverImageUrl}
>
  <main class="min-h-screen bg-yokai-light-bg">
    <PostHeader
      title={post.title}
      coverImage={coverImageUrl}
      date={post.date}
      tags={post.tags}
    />
    <PostLayout backUrl="/updates" backText={`Kembali ke Updates`}>
      <Breadcrumbs paths={[{ name: 'Updates', href: '/updates' }, { name: post.title }]} />
      
      {typeof post.content === 'string' ? (
        <div set:html={parseMarkdown(post.content)} />
      ) : (
        <PortableText value={post.content ?? []} />
      )}
      
      {relatedPosts.length > 0 && (
        <RelatedPosts posts={relatedPosts} collection="updates" />
      )}
    </PostLayout>
  </main>
</BaseLayout>
