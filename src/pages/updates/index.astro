---
/**
 * src/pages/updates/index.astro
 *
 * AUDIT NOTES (Mei 2026):
 * - Fix: `order(dateDesc)` → `order(date desc)` — dateDesc bukan field valid, itu nama ordering
 * - Fix: Hapus `category` dari query — field ini dihapus dari schema (tidak pernah ditampilkan)
 * - Fix: Hapus tipe `any` — ganti dengan typed interface
 * - Fix: Hapus manual sort setelah fetch — sudah di-sort di GROQ query
 * - image projection dilengkapi dengan { asset }
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import CinematicHero from '@components/premium/CinematicHero.astro';
import EditorialList from '@components/premium/EditorialList.astro';
import Projects from '@components/landing/Projects.astro';
import LivePerformances from '@components/landing/LivePerformances.astro';
import InContentCTA from '@components/common/InContentCTA.astro';

import { sanityClient, urlFor } from '../../lib/sanity';
import type { SanityImage } from '../../lib/sanity';

// ── GROQ Multi-Query ────────────────────────────────────────────────────────
const query = `{
  "library": *[_type in ["article", "waza"] && (!defined(draft) || draft != true)] | order(date desc)[0...6] {
    "id": slug.current,
    _type,
    wazaType,
    title,
    titleJp,
    "description": coalesce(description, excerpt, ""),
    date,
    coverImage { asset, hotspot }
  },
  "projects": *[_type == "project"] | order(sortOrder asc, releaseDate desc)[0...3],
  "performances": *[_type == "livePerformance"] | order(sortOrder asc, date desc)[0...3],
  "sns": *[_type == "snsUpdate"] | order(date desc)[0...4],
  "config": *[_type == "updatesConfig"][0]
}`;

const data = await sanityClient.fetch(query) || {};
const libraryRaw = data.library || [];
const projectsData = data.projects || [];
const performancesData = data.performances || [];
const snsUpdates = data.sns || [];
const config = data.config || {};

interface ProjectedLibraryItem {
  id: string;
  _type: string;
  wazaType?: string;
  title: string;
  titleJp?: string;
  description: string;
  date: string;
  coverImage?: import('@lib/sanity').SanityImage;
}

const typographicLibrary = libraryRaw.map((item: ProjectedLibraryItem) => {
  let url = '/library/articles/' + item.id;
  if (item._type === 'waza') {
    url = item.wazaType === 'originalMember' 
      ? '/library/original-waza/' + item.id 
      : '/library/wotagei-waza/' + item.id;
  }
  return {
    name: item.title,
    subtitle: new Date(item.date).toLocaleDateString('en-US', { year: 'numeric', month: '2-digit', day: '2-digit' }).replace(/\//g, '.'),
    href: url,
    imageUrl: item.coverImage?.asset ? urlFor(item.coverImage).width(1920).format('webp').url() : '',
    imageSeed: item.id
  };
});

const ytProjectsLink = config.projectsYoutubeLink || 'https://www.youtube.com/@yokai_ind';
const ytPerformancesLink = config.performancesYoutubeLink || 'https://www.youtube.com/@yokai_ind';
---

<BaseLayout title={`Updates | Yokai`} activePage="updates">
  <main class="min-h-screen bg-yokai-dark-bg">
    <!-- Cinematic Hero -->
    <CinematicHero title="Updates" fallbackImageSeed="updates-hero" />
    <!-- Latest Projects -->
    <div class="relative z-0 border-b border-yokai-dark-blue/10 bg-yokai-white">
      <Projects 
        projects={projectsData} 
        ctaText="View YouTube Channel" 
        ctaLink={ytProjectsLink} 
      />
      <div class="-mt-8 pb-16 pt-4 bg-yokai-white">
        <InContentCTA text="Tonton Project Lainnya" href={ytProjectsLink} />
      </div>
    </div>

    <!-- Live Performances -->
    <div class="relative z-0">
      <LivePerformances 
        performances={performancesData} 
        ctaText="Yokai on Stage"
        ctaLink={ytPerformancesLink}
        bottomCtaText="Tonton Live Performances Lainnya"
        bottomCtaLink={ytPerformancesLink}
      />
    </div>

    <!-- Social Media (SNS) Updates -->
    <div class="pt-24 pb-24 relative z-0 bg-yokai-light-bg border-y border-yokai-dark-blue/5">
      <div class="max-w-7xl mx-auto px-6 md:px-12 mb-10 flex items-center gap-4">
        <div class="w-6 h-[1px] bg-yokai-purple"></div>
        <h3 class="font-inter text-sm font-bold tracking-[0.2em] uppercase text-yokai-dark-blue">SNS Updates</h3>
      </div>
      
      {snsUpdates.length > 0 ? (
        <div class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {snsUpdates.map((sns: import('@lib/sanity').SanitySNSUpdate) => (
            <a 
              href={sns.postUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="block group bg-white border border-yokai-dark-blue/5 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1 h-full flex flex-col"
            >
              <div class="w-full aspect-square overflow-hidden bg-gray-50 relative">
                {sns.image?.asset && (
                  <img 
                    loading="lazy" 
                    decoding="async" 
                    src={urlFor(sns.image).width(400).height(400).format('webp').url()} 
                    alt="SNS Post" 
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" 
                  />
                )}
                <div class="absolute top-3 right-3 bg-white/90 backdrop-blur-sm px-2 py-1 text-[9px] font-bold uppercase tracking-widest text-yokai-dark-blue rounded-sm">
                  {sns.platform}
                </div>
              </div>
              
              <div class="p-5 flex-grow flex flex-col justify-between bg-white">
                <div>
                  <div class="flex items-center justify-between mb-3">
                    <span class="font-jakarta font-bold text-xs text-yokai-purple">{sns.author}</span>
                    <span class="text-[10px] text-gray-400 font-inter">{new Date(sns.date).toLocaleDateString('id-ID')}</span>
                  </div>
                  <p class="text-xs text-yokai-dark-blue/70 line-clamp-3 font-inter leading-relaxed">
                    {sns.contentSnippet}
                  </p>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="max-w-7xl mx-auto px-6 md:px-12">
          <p class="text-sm font-inter text-yokai-dark-blue/40 font-bold uppercase tracking-widest">
            No recent SNS updates.
          </p>
        </div>
      )}
    </div>

    <!-- The Library Feed -->
    <EditorialList title="From The Library" items={typographicLibrary} />
  </main>
</BaseLayout>
