---
/**
 * src/pages/updates/index.astro
 *
 * AUDIT NOTES (Mei 2026):
 * - Fix: `order(dateDesc)` → `order(date desc)` — dateDesc bukan field valid, itu nama ordering
 * - Fix: Hapus `category` dari query — field ini dihapus dari schema (tidak pernah ditampilkan)
 * - Fix: Hapus tipe `any` — ganti dengan typed interface
 * - Fix: Hapus manual sort setelah fetch — sudah di-sort di GROQ query
 * - image projection dilengkapi dengan { asset }
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PostHero from '@components/blog/PostHero.astro';
import PostGrid from '@components/blog/PostGrid.astro';
import Projects from '@components/landing/Projects.astro';
import LivePerformances from '@components/landing/LivePerformances.astro';
import InContentCTA from '@components/common/InContentCTA.astro';

import { sanityClient, urlFor } from '../../lib/sanity';
import type { SanityImage } from '../../lib/sanity';

// ── GROQ Multi-Query ────────────────────────────────────────────────────────
const query = `{
  "library": *[_type in ["article", "waza"] && (!defined(draft) || draft != true)] | order(date desc)[0...6] {
    "id": slug.current,
    _type,
    wazaType,
    title,
    titleJp,
    "description": coalesce(description, excerpt, ""),
    date,
    coverImage { asset, hotspot }
  },
  "projects": *[_type == "project"] | order(sortOrder asc, releaseDate desc)[0...3],
  "performances": *[_type == "livePerformance"] | order(sortOrder asc, date desc)[0...3],
  "sns": *[_type == "snsUpdate"] | order(date desc)[0...4],
  "config": *[_type == "updatesConfig"][0]
}`;

const data = await sanityClient.fetch(query) || {};
const libraryRaw = data.library || [];
const projectsData = data.projects || [];
const performancesData = data.performances || [];
const snsUpdates = data.sns || [];
const config = data.config || {};

const formattedLibrary = libraryRaw.map((item: any) => {
  let url = '/library/articles/' + item.id;
  if (item._type === 'waza') {
    url = item.wazaType === 'originalMember' 
      ? '/library/original-waza/' + item.id 
      : '/library/wotagei-waza/' + item.id;
  }
  return {
    id: item.id,
    data: {
      title: item.title,
      titleJp: item.titleJp,
      description: item.description,
      date: item.date,
      coverImage: item.coverImage?.asset ? urlFor(item.coverImage).width(800).format('webp').url() : '',
      postUrl: url,
    }
  };
});

const ytProjectsLink = config.projectsYoutubeLink || 'https://www.youtube.com/@yokai_ind';
const ytPerformancesLink = config.performancesYoutubeLink || 'https://www.youtube.com/@yokai_ind';
---

<BaseLayout title={`Updates | Yokai`} activePage="updates">
  <main class="min-h-screen bg-[#FAFAFA]">
    <!-- Dark Header Section -->
    <div class="bg-[#2A1E52] rounded-b-[3rem] shadow-[0_10px_40px_rgba(42,30,82,0.1)] relative z-10">
      <PostHero title={"Updates"} description={"Check out our newest Updates below"} />
    </div>
    <!-- Latest Projects -->
    <div class="relative z-0 border-b border-[#2A1E52]/10 bg-yokai-white">
      <Projects 
        projects={projectsData} 
        ctaText="View YouTube Channel" 
        ctaLink={ytProjectsLink} 
      />
      <div class="-mt-8 pb-16 pt-4 bg-yokai-white">
        <InContentCTA text="Tonton Project Lainnya" href={ytProjectsLink} />
      </div>
    </div>

    <!-- Live Performances -->
    <div class="relative z-0">
      <LivePerformances 
        performances={performancesData} 
        ctaText="Yokai on Stage"
        ctaLink={ytPerformancesLink}
        bottomCtaText="Tonton Live Performances Lainnya"
        bottomCtaLink={ytPerformancesLink}
      />
    </div>

    <!-- Social Media (SNS) Updates -->
    <div class="pt-16 pb-16 relative z-0 border-b border-[#2A1E52]/10 bg-[#FAFAFA]">
      <div class="max-w-7xl mx-auto px-6 md:px-12 mb-8 flex items-center gap-4">
        <div class="w-8 h-[2px] bg-[#A045BB]"></div>
        <h3 class="font-jakarta text-lg font-black uppercase tracking-widest !text-yokai-dark-blue">SNS Updates</h3>
      </div>
      
      {snsUpdates.length > 0 ? (
        <div class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {snsUpdates.map((sns: any) => (
            <a href={sns.postUrl} target="_blank" rel="noopener noreferrer" class="block group relative bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-[#2A1E52]/10 hover:-translate-y-1">
              <div class="w-full aspect-square overflow-hidden bg-gray-100 relative">
                {sns.image?.asset && (
                  <img src={urlFor(sns.image).width(400).height(400).format('webp').url()} alt="SNS Post" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                )}
                <!-- Platform Icon / Label -->
                <div class="absolute top-3 right-3 bg-white/90 backdrop-blur px-2 py-1 rounded text-[10px] font-bold uppercase tracking-widest text-[#2A1E52]">
                  {sns.platform}
                </div>
              </div>
              <div class="p-4">
                <div class="flex items-center justify-between mb-2">
                  <span class="font-bold text-xs text-[#A045BB]">{sns.author}</span>
                  <span class="text-[10px] text-gray-400 font-inter">{new Date(sns.date).toLocaleDateString('id-ID')}</span>
                </div>
                <p class="text-xs text-[#2A1E52]/80 line-clamp-3 font-inter">{sns.contentSnippet}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="max-w-7xl mx-auto px-6 md:px-12">
          <p class="text-sm font-inter text-[#2A1E52]/40 font-bold uppercase tracking-widest">No recent SNS updates.</p>
        </div>
      )}
    </div>

    <!-- The Library Feed -->
    <div class="pt-16 pb-8 relative z-0 border-b border-[#2A1E52]/10 bg-[#FAFAFA]">
      <div class="max-w-7xl mx-auto px-6 md:px-12 mb-2 flex items-center gap-4">
        <div class="w-8 h-[2px] bg-[#A045BB]"></div>
        <h3 class="font-jakarta text-lg font-black uppercase tracking-widest !text-yokai-dark-blue">From The Library</h3>
      </div>
      <PostGrid posts={formattedLibrary} collection="library" />
    </div>
  </main>
</BaseLayout>
