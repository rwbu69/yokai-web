---
/**
 * Projects.astro
 */
import { projects as localProjects } from './projects';

interface Props {
  projects: import('@lib/sanity').SanityProject[];
  ctaText?: string;
  ctaLink?: string;
}
const { projects, ctaText = 'View Full Archive', ctaLink = '/library/original-waza' } = Astro.props;

interface AnyProject {
  title: string;
  youtubeUrl?: string;
  videoId?: string;
  releaseDate?: string;
  date?: string;
}

// Use sanity data if available, fallback to local
const activeProjects: AnyProject[] = projects && projects.length > 0 ? (projects as AnyProject[]) : (localProjects as AnyProject[]);

// For Sanity, video ID has to be parsed from youtubeUrl
const getYouTubeId = (urlOrId: string) => {
  if (!urlOrId) return '';
  if (urlOrId.includes('youtube.com') || urlOrId.includes('youtu.be')) {
    const match = urlOrId.match(/[?&]v=([^&]+)/) || urlOrId.match(/youtu\.be\/([^?]+)/);
    return match ? match[1] : '';
  }
  return urlOrId; // assume it's already an ID if no URL match
};

const formattedProjects = activeProjects.map(p => {
  return {
    title: p.title,
    date: p.releaseDate ? p.releaseDate.replace(/-/g, '.') : p.date,
    videoId: getYouTubeId(p.youtubeUrl || p.videoId || ''),
  };
});
---

<section class="projects-section w-full bg-yokai-white py-12 px-6 lg:px-12 overflow-hidden">
  <div class="max-w-[90vw] mx-auto">

    <div class="projects-header flex items-end justify-between mb-0" style="opacity: 0;">
      <h2
        class="font-jakarta font-black uppercase text-yokai-dark-blue leading-none"
        style="font-size: clamp(1.8rem, 4vw, 3rem); letter-spacing: -0.04em;"
      >
        Projects
      </h2>
      <a
        href={ctaLink}
        class="font-inter text-[9px] tracking-[0.4em] uppercase text-yokai-purple"
        style="transition: color 0.25s cubic-bezier(0.4,0,0.2,1); padding-bottom: 2px;"
        onmouseover="this.style.color='var(--yokai-dark-blue)'"
        onmouseout="this.style.color='var(--yokai-purple)'"
      >
        {ctaText}
      </a>
    </div>

    <div
      id="proj-divider"
      style="height: 2px; background: rgba(42,30,82,0.15); width: 0; margin-bottom: 0;"
    ></div>

    <div class="projects-list">
      {formattedProjects.map((p, idx) => (
        <a
          class="project-row group flex flex-row items-start md:items-center gap-3 md:gap-5 py-5 border-t border-[#2a1e52]/10 no-underline"
          href={`https://www.youtube.com/watch?v=${p.videoId}`}
          target="_blank"
          rel="noopener noreferrer"
          style="opacity: 0;"
        >
          <span
            class="font-jakarta proj-index text-[#2a1e52]/10 flex-shrink-0 mt-1 md:mt-0 leading-none transition-colors duration-200"
            style="font-size: clamp(1.5rem, 3.5vw, 3rem); font-weight: 900; letter-spacing: -0.04em; min-width: clamp(2rem, 3vw, 3.5rem);"
          >
            0{idx + 1}
          </span>

          <div class="flex flex-col justify-center flex-1 pr-2">
            <h3
              class="font-jakarta proj-title font-black uppercase text-yokai-dark-blue leading-tight transition-colors duration-200"
              style="letter-spacing: -0.03em; font-size: clamp(0.85rem, 2vw, 1.65rem); line-height: 1.25;"
            >
              {p.title}
            </h3>
            <span
              class="font-inter proj-date block md:hidden text-[8px] tracking-[0.3em] uppercase text-[#2a1e52]/30 mt-2 transition-colors duration-200"
            >
              {p.date}
            </span>
          </div>

          <div class="flex items-center justify-end gap-5 flex-shrink-0">
            <span
              class="font-inter proj-date hidden md:block text-[8px] tracking-[0.3em] uppercase text-[#2a1e52]/30 whitespace-nowrap transition-colors duration-200"
            >
              {p.date}
            </span>

            <div class="proj-thumb w-[90px] h-[50px] md:w-[108px] md:h-[62px] overflow-hidden flex-shrink-0 rounded-[2px] mt-1 md:mt-0">
              <img
                src={`https://i.ytimg.com/vi/${p.videoId}/mqdefault.jpg`}
                alt={p.title}
                loading="lazy"
                class="w-full h-full object-cover block opacity-70 transition-all duration-300 group-hover:opacity-100 group-hover:scale-[1.04]"
              />
            </div>
          </div>
        </a>
      ))}
    </div>

    <div style="height: 1px; background: rgba(42,30,82,0.08);"></div>

  </div>
</section>

<style>
  .project-row:hover .proj-index {
    color: rgba(42, 30, 82, 0.25) !important;
  }

  .project-row:hover .proj-title {
    color: var(--yokai-purple) !important;
  }

  .project-row:hover .proj-date {
    color: rgba(160, 69, 187, 0.5) !important;
  }

  .project-row:hover .proj-thumb img {
    opacity: 1 !important;
    transform: scale(1.04) !important;
  }
</style>

<script>
  import anime from 'animejs/lib/anime.es.js';

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting) return;

      anime({
        targets:    '.projects-header',
        opacity:    [0, 1],
        translateY: [10, 0],
        duration:   420,
        easing:     'easeOutQuart',
        delay:      0,
      });

      anime({
        targets:  '#proj-divider',
        width:    ['0%', '100%'],
        duration: 600,
        easing:   'easeInOutQuart',
        delay:    150,
      });

      var rows = Array.from(document.querySelectorAll('.project-row'));
      rows.forEach(function(row, i) {
        var tx = i === 2 ? 0   : -(20 - i * 8);
        var ty = i === 2 ? 12  : 0;
        anime({
          targets:    row,
          opacity:    [0, 1],
          translateX: [tx, 0],
          translateY: [ty, 0],
          duration:   520,
          easing:     'easeOutQuart',
          delay:      350 + i * 110,
        });
      });

      observer.disconnect();
    });
  }, { threshold: 0.12 });

  var section = document.querySelector('.projects-section');
  if (section) observer.observe(section);
</script>
