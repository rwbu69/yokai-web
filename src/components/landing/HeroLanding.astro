---
/**
 * HeroLanding.astro
 * Accepts props from index.astro instead of fetching itself.
 * Adapted to support dynamic number of images with staggered animation.
 */
import { urlFor } from '@lib/sanity';

import local1  from '../../assets/hero-images/1.webp';
import local2  from '../../assets/hero-images/2.webp';
import local3  from '../../assets/hero-images/3.webp';
import local4  from '../../assets/hero-images/4.webp';
import local5  from '../../assets/hero-images/5.webp';
import local6  from '../../assets/hero-images/6.webp';
import local7  from '../../assets/hero-images/7.webp';
import local8  from '../../assets/hero-images/8.webp';
import local9  from '../../assets/hero-images/9.webp';
import local10 from '../../assets/hero-images/10.webp';
import local11 from '../../assets/hero-images/11.webp';
import local12 from '../../assets/hero-images/12.webp';

interface Props {
  title: string;
  subtitle: string;
  imagesData: any;
}
const { title, subtitle, imagesData } = Astro.props;

let images: string[] = [];

if (imagesData?.images && imagesData.images.length > 0) {
  images = imagesData.images.map((img: any) => 
    urlFor(img).width(800).format('webp').quality(85).url()
  );
} else {
  // Fallback if no data from sanity yet
  images = [
    local1.src, local2.src, local3.src, local4.src,
    local5.src, local6.src, local7.src, local8.src,
    local9.src, local10.src, local11.src, local12.src,
    local1.src, local2.src
  ];
}

// Desktop distribution (4 columns)
const desktopColumns: string[][] = [[], [], [], []];
images.forEach((img, i) => {
  desktopColumns[i % 4].push(img);
});

// Mobile distribution (2 columns)
const mobileColumns: string[][] = [[], []];
images.forEach((img, i) => {
  mobileColumns[i % 2].push(img);
});
---

<section class="hero-landing relative w-full h-screen overflow-hidden bg-yokai-dark-blue">
  
  {/* DESKTOP LAYOUT (4 Columns) */}
  <div class="hidden md:flex w-full h-full">
    {desktopColumns.map((col, index) => {
      const isUp = index % 2 === 0;
      const layoutClass = isUp ? 'flex-col top-0' : 'flex-col-reverse bottom-0';
      return (
        <div class="relative w-1/4 h-full overflow-hidden border-r border-yokai-white/10 group">
          <div 
            class={`desktop-track absolute w-full flex ${layoutClass}`} 
            style={isUp ? "" : "top: auto;"}
            data-count={col.length}
            data-dir={isUp ? "up" : "down"}
          >
            {[...col, ...col].map((img) => (
              <div 
                class="w-full h-screen shrink-0 bg-cover bg-position-[center_25%] md:bg-center grayscale lg:group-hover:grayscale-0 transition-all duration-700" 
                style={`background-image:url('${img}');`}
              ></div>
            ))}
          </div>
        </div>
      );
    })}
  </div>

  {/* MOBILE LAYOUT (2 Columns) */}
  <div class="flex md:hidden w-full h-full">
    {mobileColumns.map((col, index) => {
      const isLeft = index % 2 === 0;
      const layoutClass = isLeft ? 'flex-row left-0' : 'flex-row-reverse right-0';
      return (
        <div class="relative w-1/2 h-full overflow-hidden border-r border-yokai-white/10 group">
          <div 
            class={`mobile-track absolute h-full flex ${layoutClass}`} 
            style={isLeft ? "" : "left: auto;"}
            data-count={col.length}
            data-dir={isLeft ? "left" : "right"}
          >
            {[...col, ...col].map((img) => (
              <div 
                class="w-[50vw] h-full shrink-0 bg-cover bg-position-[center_25%] md:bg-center grayscale lg:group-hover:grayscale-0 transition-all duration-700" 
                style={`background-image:url('${img}');`}
              ></div>
            ))}
          </div>
        </div>
      );
    })}
  </div>

  {/* Overlay Darkening */}
  <div class="absolute inset-0 pointer-events-none z-5"
       style="background: linear-gradient(135deg, rgba(60,15,54,0.35) 0%, rgba(42,30,82,0.35) 100%); mix-blend-mode: multiply;">
  </div>

  {/* Hero Text */}
  <div class="absolute inset-0 pointer-events-none flex flex-col justify-center items-center z-10 px-8">
    <h1 class="text-[clamp(4rem,12vw,12rem)] leading-[0.8] font-black font-jakarta text-yokai-white tracking-tighter uppercase text-center mix-blend-overlay opacity-90"
        style="text-shadow: 0 4px 24px rgba(42,30,82,0.8);">
      {title}<br/>
      <span class="text-yokai-purple italic font-outfit tracking-[0.2em]">{subtitle}</span>
    </h1>
  </div>

</section>

<script>
  import anime from 'animejs/lib/anime.es.js';

  const desktopTracks = document.querySelectorAll('.desktop-track');
  const mobileTracks = document.querySelectorAll('.mobile-track');

  function setupTracks(tracks: NodeListOf<Element>, isMobile: boolean) {
    tracks.forEach((track: Element, index: number) => {
      const count = parseInt(track.getAttribute('data-count') || '0', 10);
      const dir = track.getAttribute('data-dir');
      
      const isNegative = dir === 'up' || dir === 'left';
      
      // Use anime timeline to natively handle loop and prevent tab inactivity bugs
      const tl = anime.timeline({
        loop: true,
        autoplay: false // we start it manually with a stagger
      });

      for (let i = 1; i <= count; i++) {
        // Calculate the raw numeric target based on viewport unit
        let numTarget = isMobile ? i * 50 : i * 100;
        let valStr = isNegative ? `-${numTarget}` : `${numTarget}`;
        let targetUnit = valStr + (isMobile ? 'vw' : 'vh');

        let animObj: Record<string, any> = {
          targets: track,
          duration: 1800,
          easing: 'easeInOutExpo',
        };

        if (isMobile) {
          animObj.translateX = targetUnit;
        } else {
          animObj.translateY = targetUnit;
        }

        // Wait 3200ms before starting the next slide (3200 + 1800 = 5000ms cycle)
        tl.add(animObj, '+=3200');
      }

      // Start timeline with staggered delay
      setTimeout(() => {
        tl.play();
      }, index * 150);
    });
  }

  // Initialize both sets of tracks.
  // CSS media queries will handle which is visible to the user.
  setupTracks(desktopTracks, false);
  setupTracks(mobileTracks, true);

</script>
