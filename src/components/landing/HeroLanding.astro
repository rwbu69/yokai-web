---
/**
 * HeroLanding.astro
 * Accepts props from index.astro instead of fetching itself.
 */
import { urlFor } from '@lib/sanity';

import local1  from '../../assets/hero-images/1.webp';
import local2  from '../../assets/hero-images/2.webp';
import local3  from '../../assets/hero-images/3.webp';
import local4  from '../../assets/hero-images/4.webp';
import local5  from '../../assets/hero-images/5.webp';
import local6  from '../../assets/hero-images/6.webp';
import local7  from '../../assets/hero-images/7.webp';
import local8  from '../../assets/hero-images/8.webp';
import local9  from '../../assets/hero-images/9.webp';
import local10 from '../../assets/hero-images/10.webp';
import local11 from '../../assets/hero-images/11.webp';
import local12 from '../../assets/hero-images/12.webp';

interface Props {
  title: string;
  subtitle: string;
  imagesData: any;
}
const { title, subtitle, imagesData } = Astro.props;

let imagesA: string[] = [];
let imagesB: string[] = [];
let imagesC: string[] = [];

if (imagesData?.setA?.panel1) {
  const w = 800;
  imagesA = [
    urlFor(imagesData.setA.panel1).width(w).format('webp').quality(85).url(),
    urlFor(imagesData.setA.panel2).width(w).format('webp').quality(85).url(),
    urlFor(imagesData.setA.panel3).width(w).format('webp').quality(85).url(),
    urlFor(imagesData.setA.panel4).width(w).format('webp').quality(85).url(),
  ];
  imagesB = [
    urlFor(imagesData.setB.panel1).width(w).format('webp').quality(85).url(),
    urlFor(imagesData.setB.panel2).width(w).format('webp').quality(85).url(),
    urlFor(imagesData.setB.panel3).width(w).format('webp').quality(85).url(),
    urlFor(imagesData.setB.panel4).width(w).format('webp').quality(85).url(),
  ];
  imagesC = [
    urlFor(imagesData.setC.panel1).width(w).format('webp').quality(85).url(),
    urlFor(imagesData.setC.panel2).width(w).format('webp').quality(85).url(),
    urlFor(imagesData.setC.panel3).width(w).format('webp').quality(85).url(),
    urlFor(imagesData.setC.panel4).width(w).format('webp').quality(85).url(),
  ];
} else {
  imagesA = [local1.src,  local2.src,  local3.src,  local4.src];
  imagesB = [local5.src,  local6.src,  local7.src,  local8.src];
  imagesC = [local9.src,  local10.src, local11.src, local12.src];
}
---

<section class="hero-landing relative w-full h-screen overflow-hidden bg-yokai-dark-blue grid grid-cols-2 grid-rows-2 md:flex md:flex-row">

  <div class="relative w-full h-full md:w-1/4 md:h-full overflow-hidden border-b border-r md:border-b-0 border-yokai-white/10 group">
    <div class="panel-track-1 absolute w-[300%] h-full md:w-full md:h-[300%] top-0 left-0 flex flex-row md:flex-col">
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesA[0]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesB[0]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesC[0]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
    </div>
  </div>

  <div class="relative w-full h-full md:w-1/4 md:h-full overflow-hidden border-b md:border-b-0 md:border-r border-yokai-white/10 group">
    <div class="panel-track-2 absolute w-[300%] h-full md:w-full md:h-[300%] bottom-0 left-0 md:top-auto md:left-0 flex flex-row-reverse md:flex-col-reverse" style="left: auto; right: 0;">
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesA[1]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesB[1]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesC[1]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
    </div>
  </div>

  <div class="relative w-full h-full md:w-1/4 md:h-full overflow-hidden border-r border-yokai-white/10 group">
    <div class="panel-track-3 absolute w-[300%] h-full md:w-full md:h-[300%] top-0 left-0 flex flex-row md:flex-col">
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesA[2]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesB[2]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesC[2]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
    </div>
  </div>

  <div class="relative w-full h-full md:w-1/4 md:h-full overflow-hidden group">
    <div class="panel-track-4 absolute w-[300%] h-full md:w-full md:h-[300%] bottom-0 left-0 md:top-auto md:left-0 flex flex-row-reverse md:flex-col-reverse" style="left: auto; right: 0;">
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesA[3]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesB[3]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
      <div class="w-1/3 h-full md:w-full md:h-1/3 bg-cover bg-[position:center_25%] md:bg-center grayscale lg:group-hover:grayscale-0" style={`background-image:url('${imagesC[3]}'); transition: filter 0.7s cubic-bezier(0.4,0,0.2,1);`}></div>
    </div>
  </div>

  <div class="absolute inset-0 pointer-events-none z-5"
       style="background: linear-gradient(135deg, rgba(60,15,54,0.35) 0%, rgba(42,30,82,0.35) 100%); mix-blend-mode: multiply;">
  </div>

  <div class="absolute inset-0 pointer-events-none flex flex-col justify-center items-center z-10 px-8">
    <h1 class="text-[clamp(4rem,12vw,12rem)] leading-[0.8] font-black font-jakarta text-yokai-white tracking-tighter uppercase text-center mix-blend-overlay opacity-90"
        style="text-shadow: 0 4px 24px rgba(42,30,82,0.8);">
      {title}<br/>
      <span class="text-yokai-purple italic font-outfit tracking-[0.2em]">{subtitle}</span>
    </h1>
  </div>

</section>

<script>
  import anime from 'animejs/lib/anime.es.js';

  let state = 0;

  const translateUp   = () => state === 0 ? '0%'       : state === 1 ? '-33.333%' : '-66.666%';
  const translateDown = () => state === 0 ? '0%'       : state === 1 ? '33.333%'  : '66.666%';

  setInterval(() => {
    state = (state + 1) % 3;
    const isMobile = window.innerWidth < 768;

    if (isMobile) {
      // Simple and elegant staggered horizontal sliding animation for mobile
      anime({ targets: '.panel-track-1', translateX: translateUp(), translateY: 0, duration: 1800, easing: 'easeInOutQuart', delay: 0 });
      anime({ targets: '.panel-track-2', translateX: translateDown(), translateY: 0, duration: 1800, easing: 'easeInOutQuart', delay: 100 });
      anime({ targets: '.panel-track-3', translateX: translateUp(), translateY: 0, duration: 1800, easing: 'easeInOutQuart', delay: 200 });
      anime({ targets: '.panel-track-4', translateX: translateDown(), translateY: 0, duration: 1800, easing: 'easeInOutQuart', delay: 300 });
    } else {
      // Smooth vertical sliding for desktop
      anime({ targets: '.panel-track-1', translateX: 0, translateY: translateUp(), duration: 1800, easing: 'easeInOutExpo', delay: 0   });
      anime({ targets: '.panel-track-2', translateX: 0, translateY: translateDown(), duration: 1800, easing: 'easeInOutExpo', delay: 150 });
      anime({ targets: '.panel-track-3', translateX: 0, translateY: translateUp(), duration: 1800, easing: 'easeInOutExpo', delay: 300 });
      anime({ targets: '.panel-track-4', translateX: 0, translateY: translateDown(), duration: 1800, easing: 'easeInOutExpo', delay: 450 });
    }
  }, 5000);
</script>
