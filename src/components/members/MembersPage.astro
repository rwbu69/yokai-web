---
// src/components/members/MembersPage.astro
//
// AUDIT NOTES (Mei 2026):
// - Import dari ./members.ts (lokal) DIHAPUS — hanya gunakan data dari Sanity
// - Fallback ke localMembers DIHAPUS — empty state ditampilkan jika Sanity kosong
// - Dead reference linkedin DIHAPUS — tidak ada di schema maupun frontend
// - Dead references dp-tenure, dp-city DIHAPUS — elemen tersebut tidak ada di CreditsPanel
// - Field yang di-fetch disesuaikan dengan schema member.ts yang sudah dibersihkan
// - Tipe `any` diganti dengan typed interface
// - useCdn: false sudah di-set di sanityClient

import AccordionStrip from './AccordionStrip.astro';
import CreditsPanel from './CreditsPanel.astro';
import { sanityClient, urlFor } from '@lib/sanity';
import type { SanityImage } from '@lib/sanity';

// ── TypeScript Interfaces ─────────────────────────────────────────────────────

interface SanityMemberDoc {
  _id: string;
  firstName: string;
  role: string;
  quote?: string;
  favoriteWaza?: string[];
  favoriteUchishi?: string[];
  instagram?: string;
  twitter?: string;
  photo?: SanityImage;
  gallery?: SanityImage[];
  sortOrder?: number;
}

// Shape yang digunakan oleh semua komponen members
export interface Member {
  id: number;
  firstName: string;
  role: string;
  quote: string;
  favoriteWaza: string[];
  favoriteUchishi: string[];
  instagram?: string;
  twitter?: string;
  photo: string;
  gallery: [string, string, string, string];
  socials: { instagram?: string; twitter?: string };
}

// ── Fetch dari Sanity ─────────────────────────────────────────────────────────
// Field disesuaikan dengan schema member.ts yang sudah dibersihkan.
// Tidak ada fallback ke file lokal — jika kosong, tampilkan empty state.

const sanityMembers = await sanityClient.fetch<SanityMemberDoc[]>(`
  *[_type == "member"] | order(sortOrder asc, _createdAt asc) {
    _id,
    firstName,
    role,
    quote,
    favoriteWaza,
    favoriteUchishi,
    instagram,
    twitter,
    photo {
      asset,
      hotspot
    },
    "gallery": gallery[] {
      asset,
      hotspot
    },
    sortOrder
  }
`) ?? [];

// ── Resolve Sanity Image URLs ─────────────────────────────────────────────────

const IMG_W = 400;

const members: Member[] = sanityMembers.map((m, i) => {
  const photo = m.photo?.asset
    ? urlFor(m.photo).width(IMG_W).height(600).format('webp').quality(85).url()
    : '';

  // Gallery: harus tepat 4 foto. Jika kurang, isi dengan string kosong.
  const galleryRaw = (m.gallery ?? []).slice(0, 4);
  const gallery = [
    galleryRaw[0]?.asset ? urlFor(galleryRaw[0]).width(800).height(450).format('webp').quality(85).url() : '',
    galleryRaw[1]?.asset ? urlFor(galleryRaw[1]).width(800).height(450).format('webp').quality(85).url() : '',
    galleryRaw[2]?.asset ? urlFor(galleryRaw[2]).width(800).height(450).format('webp').quality(85).url() : '',
    galleryRaw[3]?.asset ? urlFor(galleryRaw[3]).width(800).height(450).format('webp').quality(85).url() : '',
  ] as [string, string, string, string];

  return {
    id:              i + 1,
    firstName:       m.firstName,
    role:            m.role,
    quote:           m.quote        ?? '',
    favoriteWaza:    Array.isArray(m.favoriteWaza) ? m.favoriteWaza : (m.favoriteWaza ? [m.favoriteWaza as unknown as string] : []),
    favoriteUchishi: Array.isArray(m.favoriteUchishi) ? m.favoriteUchishi : (m.favoriteUchishi ? [m.favoriteUchishi as unknown as string] : []),
    instagram:       m.instagram,
    twitter:         m.twitter,
    photo,
    gallery,
    socials: { instagram: m.instagram, twitter: m.twitter },
  };
});

// ── Slim client payload (hanya field yang dibutuhkan oleh JS browser) ─────────

const clientData = members.map(m => ({
  id:        m.id,
  firstName: m.firstName,
  role:      m.role,
  quote:     m.quote,
  favoriteWaza: m.favoriteWaza,
  favoriteUchishi: m.favoriteUchishi,
  socials:   m.socials,
  gallery:   m.gallery,
  photo:     m.photo,
}));
---

{members.length === 0 ? (
  <!-- Empty State -->
  <div class="w-full h-screen bg-[#0c0c0c] flex flex-col items-center justify-center gap-6 text-center px-6">
    <div class="w-16 h-px bg-yokai-purple/30"></div>
    <p class="font-inter text-[9px] tracking-[0.6em] uppercase text-white/25">
      No Members Yet
    </p>
    <p class="font-outfit text-white/30 text-sm font-light max-w-xs">
      Anggota tim akan muncul di sini setelah ditambahkan melalui Sanity Studio.
    </p>
    <div class="w-16 h-px bg-yokai-purple/30"></div>
  </div>
) : (
  <>
    <!-- Desktop Layout -->
    <div class="members-page hidden md:flex flex-col bg-[#0c0c0c] overflow-hidden" style="height: 100dvh;">
      <AccordionStrip members={members} />
      <CreditsPanel initial={members[0]} />
    </div>

    <!-- Mobile Snap-Scroll Layout -->
    <div class="members-mobile custom-scrollbar flex md:hidden flex-col bg-[#090909] overflow-y-auto w-full h-[100dvh]" style="scroll-snap-type: y mandatory; -webkit-overflow-scrolling: touch;">
      <style>
        .custom-scrollbar::-webkit-scrollbar {
          width: 3px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
          background: rgba(255,255,255,0.02);
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
          background: rgba(255, 255, 255, 0.2);
          border-radius: 4px;
        }
      </style>
      
      {members.map((m, idx) => {
        const igHref = m.socials.instagram ? `https://instagram.com/${m.socials.instagram}` : "#";
        const twHref = m.socials.twitter ? `https://x.com/${m.socials.twitter}` : "#";
        
        return (
          <div class="relative w-full h-[100dvh] flex-shrink-0 flex flex-col" style="scroll-snap-align: start;">
            
            <!-- Top Half: Portrait with Gradient -->
            <div class="relative w-full h-[55%] flex-shrink-0">
              <img src={m.photo} class="w-full h-full object-cover object-center" loading={idx === 0 ? "eager" : "lazy"} alt={m.firstName} />
              
              <!-- Sharp linear gradient fading to solid #090909 -->
              <div class="absolute inset-0 bg-gradient-to-t from-[#090909] via-[#090909]/60 to-transparent"></div>
              
              <div class="absolute bottom-5 left-6 right-6">
                <p class="font-inter text-[8px] tracking-[0.5em] uppercase text-white/50 mb-2">Member {String(m.id).padStart(2, '0')}</p>
                <h2 class="font-jakarta font-medium uppercase text-white leading-none mb-1.5 text-4xl">{m.firstName}</h2>
                <p class="font-inter text-[10px] tracking-[0.38em] uppercase text-yokai-purple">{m.role}</p>
              </div>
            </div>

            <!-- Bottom Half: Data Panel -->
            <div class="custom-scrollbar flex-1 w-full bg-[#090909] px-6 pt-2 pb-6 overflow-y-auto border-t border-white/[0.05]">
              
              <!-- Quote -->
              {m.quote && (
                <div class="mb-4 relative mt-3">
                  <span class="absolute -top-4 -left-2 font-serif text-[40px] leading-none text-white/[0.05] select-none pointer-events-none">"</span>
                  <p class="font-outfit italic text-white/70 text-[12px] leading-snug relative z-10 pl-1">
                    {m.quote}
                  </p>
                </div>
              )}

              <!-- Waza, Uchishi & Socials -->
              <div class="flex flex-col gap-3 mb-4">
                
                <div class="flex flex-row justify-between gap-4">
                  <!-- Waza -->
                  <div class="flex-1">
                    <p class="font-inter text-[8px] tracking-[0.5em] uppercase text-white/40 mb-1.5">Favorite Waza</p>
                    <div class="flex flex-wrap gap-1">
                      {m.favoriteWaza && m.favoriteWaza.length > 0 ? m.favoriteWaza.map(item => (
                        <span class="px-2.5 py-0.5 rounded-full border border-[#3d2c7a] bg-yokai-dark-blue text-[10px] text-white/90 font-inter tracking-wide whitespace-nowrap">{item}</span>
                      )) : <span class="font-jakarta font-medium text-white/30 leading-none">—</span>}
                    </div>
                  </div>
                  
                  <!-- Socials -->
                  <div class="shrink-0 text-right">
                    <p class="font-inter text-[8px] tracking-[0.5em] uppercase text-white/40 mb-1.5">Follow</p>
                    <div class="flex flex-col gap-2.5 items-end mt-1">
                      {m.socials.instagram && (
                        <div class="flex items-center gap-1.5">
                          <a href={igHref} target="_blank" rel="noopener" class="font-inter text-[9px] tracking-[0.12em] text-white/60 hover:text-white truncate max-w-[80px]">@{m.socials.instagram}</a>
                          <svg class="w-3.5 h-3.5 shrink-0" style="color:rgba(255,255,255,0.45)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="2" y="2" width="20" height="20" rx="5"></rect><circle cx="12" cy="12" r="4.5"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
                        </div>
                      )}
                      {m.socials.twitter && (
                        <div class="flex items-center gap-1.5">
                          <a href={twHref} target="_blank" rel="noopener" class="font-inter text-[9px] tracking-[0.12em] text-white/60 hover:text-white truncate max-w-[80px]">@{m.socials.twitter}</a>
                          <svg class="w-3.5 h-3.5 shrink-0" style="color:rgba(255,255,255,0.45)" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.911-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>
                        </div>
                      )}
                    </div>
                  </div>
                </div>

                <!-- Uchishi -->
                <div>
                  <p class="font-inter text-[8px] tracking-[0.5em] uppercase text-white/40 mb-1.5">Favorite Uchishi</p>
                  <div class="flex flex-wrap gap-1">
                    {m.favoriteUchishi && m.favoriteUchishi.length > 0 ? m.favoriteUchishi.map(item => (
                      <span class="px-2.5 py-0.5 rounded-full border border-[#3d2c7a] bg-yokai-dark-blue text-[10px] text-white/90 font-inter tracking-wide whitespace-nowrap">{item}</span>
                    )) : <span class="font-jakarta font-medium text-white/30 leading-none">—</span>}
                  </div>
                </div>
              </div>

              <!-- Gallery -->
              {m.gallery && m.gallery.some(g => g) && (
                <div class="mb-2">
                  <p class="font-inter text-[8px] tracking-[0.5em] uppercase text-white/40 mb-2">Gallery</p>
                  <div class="grid grid-cols-2 gap-1.5">
                    {m.gallery.filter(g => g).map(g => (
                      <img src={g} class="w-full aspect-video object-cover rounded-[2px] opacity-60 border border-white/5" loading="lazy" />
                    ))}
                  </div>
                </div>
              )}

            </div>
          </div>
        );
      })}
    </div>
  </>
)}

<!-- ① Data bridge -->
<script define:vars={{ __m: clientData }}>
  window.__YOKAI_M = __m;
</script>

<!-- ② Orchestration script — vanilla JS -->
<script>
  import anime from 'animejs/lib/anime.es.js';
  import type { Member } from './MembersPage.astro';

  declare global {
    interface Window {
      __YOKAI_M?: Member[];
    }
  }

  var members: Member[] = window.__YOKAI_M || [];
  var strips        = Array.from(document.querySelectorAll<HTMLElement>('[data-strip-id]'));
  var creditsInner  = document.getElementById('credits-inner');
  var accordion     = document.querySelector<HTMLElement>('.accordion-strip');

  // Detail panel DOM refs
  var dpName1  = document.getElementById('dp-name1');
  var dpRole   = document.getElementById('dp-role');
  var dpFavWaza    = document.getElementById('dp-fav-waza');
  var dpFavUchishi = document.getElementById('dp-fav-uchishi');
  var dpQuote  = document.getElementById('dp-quote');

  var active      = -1;
  var isAnimating = false;

  // ── Pixel-integer widths ─────────────────────────────────────────────
  function getTargetWidths(activeIdx: number) {
    var isMobile = window.innerWidth < 768;
    if (isMobile) {
      var activeWidth = Math.min(260, window.innerWidth * 0.7);
      var restWidth = 60;
      return members.map(function(_, i: number) { return i === activeIdx ? activeWidth : restWidth; });
    }
    var total  = accordion ? accordion.offsetWidth : window.innerWidth;
    var active = Math.round(total * 0.40);
    var rest   = Math.round((total - active) / (members.length - 1));
    return members.map(function(_, i: number) { return i === activeIdx ? active : rest; });
  }

  // ── Strip animation ──────────────────────────────────────────────────
  function animateStrips(activeIdx: number) {
    if (isAnimating) return;
    isAnimating = true;
    if (accordion) accordion.style.pointerEvents = 'none';
    var widths = getTargetWidths(activeIdx);
    var isMobile = window.innerWidth < 768;

    anime({
      targets: strips,
      width: function(_el: HTMLElement, i: number) { return widths[i]; },
      duration: 600,
      easing: 'easeInOutQuart',
      begin: function() {
        strips.forEach(function(s: HTMLElement) { s.style.willChange = 'width'; });
        if (isMobile && accordion) {
          var offsetLeft = 0;
          for (var i = 0; i < activeIdx; i++) offsetLeft += widths[i];
          var centerPos = offsetLeft - (window.innerWidth / 2) + (widths[activeIdx] / 2);
          accordion.scrollTo({ left: centerPos, behavior: 'smooth' });
        }
      },
      complete: function() {
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            strips.forEach(function(s: HTMLElement) { s.style.willChange = 'auto'; });
            if (accordion) accordion.style.pointerEvents = '';
            isAnimating = false;
          });
        });
      },
    });
  }

  // ── Social link updater ──────────────────────────────────────────────
  function setSocial(platformId: string, handle: string | undefined, baseUrl: string) {
    var row  = document.getElementById('dp-' + platformId);
    var link = document.getElementById('dp-' + platformId + '-link') as HTMLAnchorElement | null;
    if (!row || !link) return;
    if (handle) {
      row.style.display = '';
      link.textContent  = handle;
      link.href = 'https://' + baseUrl + '/' + handle.replace('@', '');
    } else {
      row.style.display = 'none';
    }
  }

  // ── Gallery updater ──────────────────────────────────────────────────
  function updateGallery(gallery: string[]) {
    for (var i = 0; i < 4; i++) {
      var img = document.getElementById('dp-gallery-' + i) as HTMLImageElement | null;
      if (img && gallery[i]) img.src = gallery[i];
    }
  }

  // ── Detail panel text + gallery update ──────────────────────────────
  function updateDetail(m: Member) {
    if (dpName1)      dpName1.textContent      = m.firstName;
    if (dpRole)       dpRole.textContent       = m.role;
    if (dpFavWaza) {
      var w = m.favoriteWaza;
      if (!Array.isArray(w)) w = w ? [w] : [];
      if (w.length > 0) {
        dpFavWaza.innerHTML = w.map(function(item: string) {
          return '<span class="px-3 py-1 rounded-full border border-[#3d2c7a] bg-yokai-dark-blue text-sm text-white/90 font-inter tracking-wide whitespace-nowrap">' + item + '</span>';
        }).join('');
      } else {
        dpFavWaza.innerHTML = '<span class="font-jakarta font-medium text-white leading-none" style="font-size:18px;">—</span>';
      }
    }
    if (dpFavUchishi) {
      var u = m.favoriteUchishi;
      if (!Array.isArray(u)) u = u ? [u] : [];
      if (u.length > 0) {
        dpFavUchishi.innerHTML = u.map(function(item: string) {
          return '<span class="px-3 py-1 rounded-full border border-[#3d2c7a] bg-yokai-dark-blue text-sm text-white/90 font-inter tracking-wide whitespace-nowrap">' + item + '</span>';
        }).join('');
      } else {
        dpFavUchishi.innerHTML = '<span class="font-jakarta font-medium text-white leading-none" style="font-size:18px;">—</span>';
      }
    }
    if (dpQuote)      dpQuote.textContent      = m.quote;
    setSocial('instagram', m.socials.instagram, 'instagram.com');
    setSocial('twitter',   m.socials.twitter,   'x.com');
    updateGallery(m.gallery || []);
  }

  // ── Core state setter ────────────────────────────────────────────────
  function setActive(idx: number) {
    if (idx === active) return;

    var isFirstLoad = active === -1;
    var dir = idx > active ? -1 : 1;

    strips.forEach(function(s: HTMLElement, i: number) { s.classList.toggle('active', i === idx); });

    var m = members[idx];
    active = idx;
    if (!m) return;

    animateStrips(idx);

    if (isFirstLoad) return;

    var SLIDE = 36;

    anime({
      targets: creditsInner,
      translateX: dir * SLIDE,
      opacity: 0,
      duration: 150,
      easing: 'easeInQuart',
      begin: function() {
        if (creditsInner) creditsInner.style.willChange = 'transform, opacity';
      },
      complete: function() {
        updateDetail(m);
        anime.set(creditsInner, { translateX: -dir * SLIDE });
        anime({
          targets: creditsInner,
          translateX: 0,
          opacity: 1,
          duration: 300,
          easing: 'easeOutQuart',
          complete: function() {
            requestAnimationFrame(function() {
              requestAnimationFrame(function() {
                if (creditsInner) creditsInner.style.willChange = 'auto';
              });
            });
          },
        });
      },
    });
  }

  // ── Event bindings ───────────────────────────────────────────────────
  strips.forEach(function(strip, i) {
    strip.addEventListener('click', function() { setActive(i); });
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'ArrowRight') setActive((active + 1) % members.length);
    if (e.key === 'ArrowLeft')  setActive((active + members.length - 1) % members.length);
  });

  // ── Init ─────────────────────────────────────────────────────────────
  setActive(0);
</script>
