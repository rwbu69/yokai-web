---
/**
 * ShopHero.astro
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<section class="w-full pt-10 pb-16 px-6 md:px-12 relative z-10 max-w-7xl mx-auto">
  <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 border-b border-yokai-white/10 pb-12">
    <h1 class="font-jakarta font-black uppercase text-yokai-white text-5xl md:text-[6rem] tracking-tighter leading-[0.9]">
      {title}
    </h1>
  </div>
</section>
