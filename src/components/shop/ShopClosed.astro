---
/**
 * ShopClosed.astro
 */
interface Props {
  message: string;
  type?: 'cheki' | 'merch';
}
const { message, type = 'merch' } = Astro.props;
---
<div class="w-full max-w-7xl mx-auto px-6 md:px-12 pb-32 pt-12 relative z-10">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-start">
    
    <!-- Left Column: Status Stamp -->
    <div class="lg:col-span-3 flex flex-col gap-1 mt-2">
      <span class="font-inter text-[10px] font-bold text-yokai-white/30 tracking-[0.3em] uppercase">
        STATUS
      </span>
      <span class="font-jakarta text-xs font-bold text-yokai-purple tracking-widest uppercase">
        ORDER TUTUP
      </span>
      <div class="w-full h-[1px] bg-yokai-white/10 mt-6 hidden lg:block"></div>
    </div>

    <!-- Right Column: Message & CTA -->
    <div class="lg:col-span-7 lg:col-start-5 flex flex-col">
      <h2 class="font-jakarta font-black uppercase text-yokai-white text-3xl md:text-5xl tracking-tighter leading-none mb-8">
        {message}
      </h2>
      
      <div class="w-full h-[1px] bg-yokai-white/10 mb-8"></div>
      
      <a href="https://instagram.com/yokai.ind" target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-4 text-yokai-white/70 hover:text-yokai-purple transition-colors uppercase font-inter text-[10px] font-bold tracking-[0.3em] w-fit">
        <span>Terhubung di @yokai.ind</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-2 transition-transform duration-300 ease-out" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>
    
  </div>
</div>
