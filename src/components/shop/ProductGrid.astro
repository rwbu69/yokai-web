---
/**
 * src/components/shop/ProductGrid.astro
 */
interface ShopItem {
  id: string;
  name: string;
  price?: number;
  available: boolean;
  description?: string;
  variants?: string[];
  imageUrl?: string;
}

interface Props {
  type: 'cheki' | 'merch';
  items: ShopItem[];
}

const { type, items } = Astro.props;
---

<div class="w-full max-w-7xl mx-auto px-4 pb-8">
  <div class="product-grid flex flex-nowrap overflow-x-auto snap-x snap-mandatory gap-6 w-fit mx-auto max-w-full hidden-scrollbar">
    {items.map((item) => (
      <div 
        class={`product-card flex-shrink-0 w-[85vw] md:w-[600px] snap-center group relative flex flex-row items-stretch bg-yokai-dark-blue/40 backdrop-blur-md border border-yokai-white/10 overflow-hidden cursor-pointer transition-all duration-500 hover:border-yokai-purple/50 min-h-[160px] md:h-64 ${!item.available ? 'opacity-50 grayscale' : 'hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(160,69,187,0.3)]'}`}
      data-item={JSON.stringify(item)}
    >
      <!-- Image Container -->
      <div class="relative w-1/3 md:w-2/5 flex-shrink-0 overflow-hidden bg-yokai-dark-bg h-full">
        {item.imageUrl ? (
          <img 
            src={item.imageUrl} 
            alt={item.name} 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-yokai-white/20 font-inter text-xs tracking-widest uppercase">No Image</div>
        )}
        
        <!-- Overlay Gradient -->
        <div class="absolute inset-0 bg-gradient-to-t from-yokai-dark-bg via-transparent to-transparent opacity-80 pointer-events-none"></div>
        
        <!-- Status Badge -->
        {!item.available && (
          <div class="absolute top-4 left-4 bg-red-500 text-white text-[10px] font-jakarta font-black uppercase tracking-widest px-3 py-1 shadow-lg">
            SOLD OUT
          </div>
        )}
      </div>

      <!-- Info Container -->
      <div class="relative p-4 md:p-6 flex flex-col flex-grow bg-transparent z-10 border-l border-yokai-white/10 group-hover:border-yokai-purple/30 transition-colors duration-500 overflow-hidden">
        <h3 class="font-jakarta font-bold text-lg md:text-xl text-yokai-white mb-1 line-clamp-2 drop-shadow-md">{item.name}</h3>
        
        {item.price && (
          <p class="font-inter text-yokai-purple font-bold mb-2">
            Rp {item.price.toLocaleString('id-ID')}
          </p>
        )}

        <p class="font-outfit text-yokai-white/60 text-xs md:text-sm line-clamp-2 md:line-clamp-3 mb-auto">
          {item.description || 'Barang resmi Yokai.'}
        </p>
        
        <div class="mt-4 pt-3 border-t border-yokai-white/10 flex items-center justify-between">
          <div class="flex items-center gap-2">
            {item.variants && item.variants.length > 0 && item.variants.slice(0, 3).map(v => (
              <span class="text-[9px] md:text-[10px] font-bold tracking-widest uppercase bg-yokai-white/10 text-yokai-white/80 px-2 py-0.5 rounded-sm">
                {v}
              </span>
            ))}
            {item.variants && item.variants.length > 3 && (
              <span class="text-[9px] md:text-[10px] font-bold tracking-widest text-yokai-white/50 px-1 py-0.5">
                +{item.variants.length - 3}
              </span>
            )}
          </div>
          <svg class="w-5 h-5 text-yokai-white/30 group-hover:text-yokai-purple transform group-hover:translate-x-1 transition-all duration-300 hidden sm:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </div>
      </div>
      </div>
    ))}
  </div>
</div>

<script>
  // Handle click on product cards to open the modal
  const cards = document.querySelectorAll('.product-card');
  
  cards.forEach(card => {
    card.addEventListener('click', () => {
      const itemData = card.getAttribute('data-item');
      if (itemData) {
        const item = JSON.parse(itemData);
        if (item.available) {
          // Dispatch a custom event that the modal component will listen to
          const event = new CustomEvent('open-shop-modal', { detail: item });
          document.dispatchEvent(event);
        }
      }
    });
  });
</script>
