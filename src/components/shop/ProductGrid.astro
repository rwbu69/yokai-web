---
/**
 * src/components/shop/ProductGrid.astro
 */
interface ShopItem {
  id: string;
  name: string;
  price?: number;
  available: boolean;
  description?: string;
  variants?: string[];
  imageUrl?: string;
}

interface Props {
  type: 'cheki' | 'merch';
  items: ShopItem[];
}

const { type, items } = Astro.props;
---

<div class="product-grid w-full max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 px-4">
  {items.map((item) => (
    <div 
      class={`product-card group relative flex flex-col bg-yokai-dark-blue/40 backdrop-blur-md border border-yokai-white/10 overflow-hidden cursor-pointer transition-all duration-500 hover:border-yokai-purple/50 ${!item.available ? 'opacity-50 grayscale' : 'hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(160,69,187,0.3)]'}`}
      data-item={JSON.stringify(item)}
    >
      <!-- Image Container -->
      <div class="relative w-full aspect-[4/5] overflow-hidden bg-yokai-dark-bg">
        {item.imageUrl ? (
          <img 
            src={item.imageUrl} 
            alt={item.name} 
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class="w-full h-full flex items-center justify-center text-yokai-white/20 font-inter text-xs tracking-widest uppercase">No Image</div>
        )}
        
        <!-- Overlay Gradient -->
        <div class="absolute inset-0 bg-gradient-to-t from-yokai-dark-bg via-transparent to-transparent opacity-80 pointer-events-none"></div>
        
        <!-- Status Badge -->
        {!item.available && (
          <div class="absolute top-4 left-4 bg-red-500 text-white text-[10px] font-jakarta font-black uppercase tracking-widest px-3 py-1 shadow-lg">
            SOLD OUT
          </div>
        )}
      </div>

      <!-- Info Container -->
      <div class="relative p-6 flex flex-col flex-grow bg-gradient-to-b from-transparent to-yokai-dark-bg z-10 -mt-12">
        <h3 class="font-jakarta font-bold text-xl text-yokai-white mb-2 line-clamp-2 drop-shadow-md">{item.name}</h3>
        
        {item.price && (
          <p class="font-inter text-yokai-purple font-medium mb-4">
            Rp {item.price.toLocaleString('id-ID')}
          </p>
        )}
        
        <div class="mt-auto pt-4 flex items-center justify-between border-t border-yokai-white/10 group-hover:border-yokai-purple/30 transition-colors duration-300">
          <span class="font-inter text-[10px] tracking-[0.2em] uppercase text-yokai-white/50 group-hover:text-yokai-purple transition-colors">
            {item.available ? 'Pesan Sekarang' : 'Habis'}
          </span>
          <svg class="w-5 h-5 text-yokai-white/30 group-hover:text-yokai-purple transform group-hover:translate-x-1 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
        </div>
      </div>
    </div>
  ))}
</div>

<script>
  // Handle click on product cards to open the modal
  const cards = document.querySelectorAll('.product-card');
  
  cards.forEach(card => {
    card.addEventListener('click', () => {
      const itemData = card.getAttribute('data-item');
      if (itemData) {
        const item = JSON.parse(itemData);
        if (item.available) {
          // Dispatch a custom event that the modal component will listen to
          const event = new CustomEvent('open-shop-modal', { detail: item });
          document.dispatchEvent(event);
        }
      }
    });
  });
</script>
