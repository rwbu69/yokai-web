---
export interface BreadcrumbPath {
  name: string;
  href?: string;
}

interface Props {
  paths: BreadcrumbPath[];
  theme?: 'light' | 'dark';
}

const { paths, theme = 'light' } = Astro.props;

const isDark = theme === 'dark';
const linkClass = isDark ? "text-white/50 hover:text-yokai-purple transition-colors font-bold" : "text-yokai-dark-blue/40 hover:text-yokai-purple transition-colors font-bold";
const currentClass = isDark ? "text-white font-black" : "text-yokai-dark-blue font-black";
const slashClass = isDark ? "text-white/30" : "text-yokai-dark-blue/30";
---
<nav aria-label="Breadcrumb" class="w-full flex items-center justify-start py-4 px-6 md:px-12 relative z-20">
  <ol class="flex items-center gap-2 font-inter text-[10px] md:text-xs tracking-[0.2em] uppercase">
    <li>
      <a href="/" class={linkClass}>Home</a>
    </li>
    {paths.map((path, index) => (
      <li class="flex items-center gap-2">
        <span class={slashClass}>/</span>
        {path.href ? (
          <a href={path.href} class={linkClass}>{path.name}</a>
        ) : (
          <span class={currentClass}>{path.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
