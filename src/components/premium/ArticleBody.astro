---
export interface Props {
  emptyMessage?: string;
  hasContent?: boolean;
}

const { emptyMessage = "No content available.", hasContent = true } = Astro.props;
---

<section class="w-full bg-white text-yokai-dark-bg pb-32 pt-16 px-6 md:px-12">
  <div class="max-w-3xl mx-auto w-full article-content">
    {hasContent ? (
      <slot />
    ) : (
      <p class="text-gray-400 italic text-xl font-inter text-center py-24">{emptyMessage}</p>
    )}
  </div>
</section>

<style is:global>
  /* Custom Article Formatting */
  .article-content {
    font-family: 'Inter', sans-serif;
    color: #2D3748; /* Dark gray for high readability */
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .article-content p {
    margin-bottom: 1.75rem;
  }

  .article-content h1, 
  .article-content h2, 
  .article-content h3, 
  .article-content h4 {
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: var(--yokai-purple);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    line-height: 1.3;
  }

  .article-content h1 { font-size: 2.5rem; }
  .article-content h2 { font-size: 2rem; }
  .article-content h3 { font-size: 1.5rem; }

  .article-content blockquote {
    border-left: 4px solid var(--yokai-purple);
    background-color: #F7FAFC;
    padding: 1.5rem 1.5rem 1.5rem 2rem;
    margin: 2rem 0;
    border-radius: 0 0.5rem 0.5rem 0;
    font-style: italic;
    color: #4A5568;
    font-weight: 500;
  }
  
  .article-content blockquote p {
    margin-bottom: 0;
  }

  .article-content a {
    color: var(--yokai-purple);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }

  .article-content a:hover {
    color: #000;
  }

  .article-content strong {
    color: #1A202C;
    font-weight: 800;
  }

  .article-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .article-content ol {
    list-style-type: decimal;
    padding-left: 1.5rem;
    margin-bottom: 1.75rem;
  }

  .article-content li {
    margin-bottom: 0.5rem;
  }

  .article-content img {
    border-radius: 0.5rem;
    width: 100%;
    height: auto;
    margin: 2.5rem 0;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  }

  .article-content hr {
    border: none;
    border-top: 1px solid #E2E8F0;
    margin: 3rem 0;
  }
</style>
