---
export interface EditorialItem {
  name: string;
  subtitle?: string;
  href: string;
}

export interface Props {
  title?: string;
  items: EditorialItem[];
  emptyMessage?: string;
}

const {
  title = "Latest Entries",
  items = [],
  emptyMessage = "No items found.",
} = Astro.props;
---

<section
  class="w-full bg-yokai-dark-bg py-24 px-6 md:px-12 border-t border-yokai-white/10"
>
  <div class="max-w-7xl mx-auto flex flex-col">
    <div class="flex items-center gap-4 mb-16">
      <div class="w-8 h-[2px] bg-yokai-purple"></div>
      <h3
        class="font-jakarta text-lg font-black uppercase tracking-widest text-yokai-white"
      >
        {title}
      </h3>
    </div>

    <div class="flex flex-col border-t border-yokai-white/10">
      {
        items.map((item) => (
          <a
            href={item.href}
            class="group flex flex-col md:flex-row md:items-center justify-between py-8 md:py-10 border-b border-yokai-white/10 hover:border-yokai-purple transition-colors duration-300"
          >
            <div class="flex flex-col md:flex-row md:items-center gap-4 md:gap-12 flex-1">
              {item.subtitle && (
                <span class="font-inter text-[10px] text-yokai-white/40 tracking-[0.3em] uppercase w-24">
                  {item.subtitle}
                </span>
              )}
              <h4 class="font-jakarta font-bold text-2xl md:text-4xl text-yokai-white group-hover:text-yokai-purple transition-colors duration-300">
                {item.name}
              </h4>
            </div>

            <div class="mt-6 md:mt-0 opacity-0 group-hover:opacity-100 transform -translate-x-4 group-hover:translate-x-0 transition-all duration-300 flex items-center gap-3 text-yokai-white">
              <span class="text-[10px] font-bold tracking-widest uppercase text-yokai-purple">
                Read
              </span>
              <svg
                class="w-6 h-6 text-yokai-purple"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </div>
          </a>
        ))
      }

      {
        items.length === 0 && (
          <p class="py-12 text-yokai-white/30 font-inter uppercase tracking-widest text-sm text-center">
            {emptyMessage}
          </p>
        )
      }
    </div>
  </div>
</section>
